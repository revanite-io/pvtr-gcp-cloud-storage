project_id = "your-gcp-project-id"
region     = "us-central1"

# Optional: specify a bucket name (auto-generated if empty)
# bucket_name = "my-custom-bucket-name"

# Optional: lock retention policy (cannot be undone)
# retention_policy_locked = true

# Optional: retention period in seconds (default: 1 day)
# retention_period_seconds = 86400

# Optional: soft delete retention in seconds (default: 7 days)
# soft_delete_retention_seconds = 604800

labels = {
  environment = "test"
  managed_by  = "terraform"
  project     = "pvtr-gcp-cloud-storage"
}
